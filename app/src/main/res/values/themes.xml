<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MediaServerAndroid" parent="android:Theme.Material.NoActionBar">
        <!--        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">always</item>-->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="Theme.MediaServerAndroid.Fullscreen" parent="Theme.MediaServerAndroid">
        <item name="android:actionBarStyle">
            @style/Widget.Theme.MediaServerAndroid.ActionBar.Fullscreen
        </item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.MediaServerAndroid.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>
</resources>